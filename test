def write_to_csv(data, csv_file_path):
    """Writes the collected compliance data to a CSV file."""
    with open(csv_file_path, mode='w', newline='') as file:
        writer = csv.DictWriter(file, fieldnames=[
            "Name", "Location", "Account ID", "Account Name", "Compliance","Resource ID", "Resource Type",
             "Reason", "Evaluation Time", "Bit ID", "Environment", "Additional Bit Ids"
        ])
        writer.writeheader()
        writer.writerows(data)


class TagRule(ABC):
    supported_resource_types = ["ec2", "elasticloadbalancing", "s3", "rds", "cloudfront", "storagegateway",
                                "elasticfilesystem"]
    supported_resource_types_ec2 = ["instance", "vpc", "subnet", "route-table", "internet-gateway", "natgateway",
                           "customer-gateway", "transit-gateway", "volume", "security-group", "network-acl",
                           "networkacl", "dhcpoptions"]

    supported_iam_list = [
        "GBS-ITO-CloudOps-Support-NA-Global-AWS-Admins",
        "GBS-ITO-CloudOps-Support-EU-Global-AWS-Admins",
        "GBS-ITO-CloudOps-Support-NA-Global-AWS-ReadOnly",
        "GBS-ITO-CloudOps-Support-EU-Global-AWS-ReadOnly",
        "AWSReservedSSO_CIEM-InfraOpsSupportAdmin",
        "AWSReservedSSO_CIEM-InfraOpsSupportReader",
        "AWSServiceRoleForSupport",
        "WK-Custom-AdministratorAccess",
        "WK-Custom-AmazonSSMManagedInstanceCore",
        "WK-Custom-Billing",
        "WK-Custom-NetworkAdministrator",
        "WK-Custom-OrganizationAccountAccessRole",
        "WK-Custom-PowerUserAccess",
        "WK-Custom-S3Reader",
        "WK-Custom-StandardAdministrator",
        "WK-Custom-SystemAdministrator",
        "WK-Custom-ViewOnlyAccess",
        "WK-Custom-WK-DBA",
        "AWSReservedSSO_AdministratorAccess_",
        "AWSReservedSSO_BillingViewOnly_",
        "AWSReservedSSO_NetworkAdministrator_",
        "AWSReservedSSO_PowerUserAccess_",
        "AWSReservedSSO_Readonlyaccess-Global_",
        "AWSReservedSSO_StandardAdministrator_",
        "AWSReservedSSO_SystemAdministrator_",
        "AWSReservedSSO_ViewOnlyAccess_"]

    @abstractmethod
    def is_compliant(self, tags) -> bool:
        """Check if the resource is compliant with this rule."""
        pass

    @abstractmethod
    def get_rule_name(self) -> str:
            """Return a name of the compliance rule."""
            return "rule name"

    def get_bitid_metadata(self, resource_tag_mapping):
        tag_values = {
            'bit_id': None,
            'environment': None,
            'additional_bit_ids': None
        }
        return tag_004_data.get(resource_tag_mapping['ResourceARN'], tag_values)

    def is_res_type_exempt(self, resoure_arn):
        is_res_type_exempt = True
        chunks = resoure_arn.split(":")
        if chunks[2] in self.supported_resource_types:
            if chunks[2] == "ec2":
                if chunks[5].split('/')[0] in self.supported_resource_types_ec2:
                    is_res_type_exempt = False
            elif chunks[2] == 'iam':
                role_name = resoure_arn.split('/')[-1]
                if role_name in self.supported_iam_list:
                    is_res_type_exempt = False
            else:
                is_res_type_exempt = False
        return is_res_type_exempt

    def is_resource_exempted(self, resource_id, rule_name, exception_entities):
        today = datetime.now().date()
        for entity in exception_entities:
            expirationdate = datetime.fromisoformat(str(entity['ExpirationDate'])).date()
            resource_exception = (
                    entity['PartitionKey'] == resource_id and entity['RowKey'] == rule_name and expirationdate > today
            )
            if resource_exception:
                compliance = 'EXEMPTED'

        if rule_name in exempted_rules_agg_domains:
            print(f"{resource_id} exempted as the associated domain is exempted")
            compliance = 'EXEMPTED'

    def get_resource_type(self, resource_id):
        capital_letter_services = ['iam', 'ssm', 'ec2', 's3']
        if resource_id.startswith("arn"):
            s = resource_id.split("/")
            split = s[0].split(":")
            if split[2] in capital_letter_services:
                split[2] = split[2].upper()
            else:
                split[2] = split[2].capitalize()
            if split[2] == 'S3' and not split[3] and not split[4]:
                resource_type = 'AWS::S3::Bucket'
            elif split[2] == 'Apigateway':
                resource_type = 'AWS::ApiGateway'
            elif split[2] == 'Sqs':
                resource_type = 'AWS::SQS'
            elif split[2] == 'Sns':
                resource_type = 'AWS::SNS'
            else:
                resource_type = 'AWS::' + split[2] + '::' + split[5].capitalize()
        else:
            if resource_id.startswith("vpc-"):
                resource_type = 'AWS::EC2::VPC'
            elif resource_id.startswith("subnet-"):
                resource_type = 'AWS::EC2::Subnet'
            elif resource_id.startswith("i-"):
                resource_type = 'AWS::EC2::Instance'
        return resource_type

    def get_evaluation(self, resource_tag_mapping):
        tags_metadata = self.get_bitid_metadata(resource_tag_mapping)
        compliance, reason = self.is_compliant(resource_tag_mapping)
        resource_data = {
            "Name": self.get_rule_name(),
            "Location": region,
            "Account ID": account_id,
            "Account Name": "N/A",  # Todo Fetch account name
            "Compliance": compliance,
            "Resource Type": self.get_resource_type(resource_tag_mapping.get('ResourceARN')),
            "Resource ID": resource_tag_mapping['ResourceARN'],
            "Reason": reason,
            "Evaluation Time": datetime.now().isoformat(),
            "Bit ID": tags_metadata["bit_id"],
            "Environment": tags_metadata["environment"],
            "Additional Bit Ids": tags_metadata["additional_bit_ids"]
        }
        return resource_data


class Tag004(TagRule):
    supported_resource_types = ["ec2", "elasticloadbalancing", "s3", "rds", "cloudfront", "storagegateway",
                               "elasticfilesystem", 'config', 'backup', 'ssm']

    def is_compliant(self, resource_tag_mapping) -> (str, str):
        """Check compliance for tag004"""
        compliance = "NON_COMPLIANT"
        reason =  "No tags or missing required tags"
        tag_values = {
            'bit_id': None,
            'environment': None,
            'additional_bit_ids': None
        }

        for tag in resource_tag_mapping['Tags']:
            key = tag['Key']
            value = tag['Value'] or "None"

            if key == 'wk_application_bit_id':
                tag_values['bit_id'] = value
                if self.app_bit_id_tag_is_valid(value):
                    compliance = 'COMPLIANT'
                    reason = None
            elif key == 'wk_environment_name':
                tag_values['environment'] = value
            elif key == 'wk_additional_bit_ids':
                tag_values['additional_bit_ids'] = value
        reason_parts = []
        if tag_values['bit_id']:
            reason_parts.append(f"bitid is: {tag_values['bit_id']}")
        if tag_values['environment']:
            reason_parts.append(f"env is: {tag_values['environment']}")
        if tag_values['additional_bit_ids']:
            reason_parts.append(f"bitids are: {tag_values['additional_bit_ids']}")

        reason = ";; ".join(reason_parts) if reason_parts else "None"
        return compliance, reason

    def app_bit_id_tag_is_valid(self, tag):
        """Validates the wk_application_bit_id tag using regex."""
        return re.fullmatch(r'^0[478]\d{2}[A-Za-z0-9]{8}$', tag) is not None

    def get_rule_name(self) -> str:
        return "wk_tag_004_wk_application_bit_id_tag_check"

    def get_bitid_metadata(self,resource_tag_mapping):
        tag_values = {
            'bit_id': None,
            'environment': None,
            'additional_bit_ids': None
        }
        for tag in resource_tag_mapping['Tags']:
            key = tag['Key']
            value = tag['Value'] or "None"

            if key == 'wk_application_bit_id':
                tag_values['bit_id'] = value
            elif key == 'wk_environment_name':
                tag_values['environment'] = value
            elif key == 'wk_additional_bit_ids':
                tag_values['additional_bit_ids'] = value
        tag_004_data[resource_tag_mapping['ResourceARN']] = tag_values
        return tag_values


