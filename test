class Tag009(TagRule):
    supported_resource_types = ["ec2"]
    supported_resource_types_ec2 = ["instance"]
    regex_compliant_patchclass = r'^C([1-5])W([1-4])L?N?R?(M|T|W|R|F|S|U)'
    allowedpatchvalues = ["appliance", "manual"]

    def is_compliant(self, resource_tag_mapping) -> (str, str):
        compliance = "NON_COMPLIANT"
        reason =  "No tags or missing required tags"
        for tag in resource_tag_mapping['Tags']:
            if tag['Key'] == 'wk_patch_class':
                if tag['Value'].lower() in self.allowedpatchvalues:
                    compliance = 'COMPLIANT'
                    reason = ""
                elif self.value_is_a_patch_class(tag['Value']):
                    compliance = 'COMPLIANT'
                    reason = ""
                else:
                    compliance = "NON_COMPLIANT"
                    reason = "Wrong Tag Value"
        return compliance, reason

    def value_is_valid_bu_code(self, tag):
        return re.fullmatch(r'b\d{3}', tag) is not None

    def get_rule_name(self) -> str:
        return "wk_tag_009_wk_patch_class_tag_check"

    def value_is_a_patch_class(self, tag_value):
        if re.search(self.regex_compliant_patchclass, tag_value, re.IGNORECASE) is not None:
            return re.search(self.regex_compliant_patchclass, tag_value, re.IGNORECASE)
        return None

def get_resources_evaluation_w_tags(region: str):
        resourcetagging = boto3.client('resourcegroupstaggingapi', region_name=region)

        #fetch resources
        tag_rules = [Tag004(), Tag001(), Tag002(), Tag005(), Tag008(), Tag009()]
        #tag_rules = [Tag004(), Tag008()]
        resource_paginator = resourcetagging.get_paginator('get_resources')
        pages = resource_paginator.paginate()
        all_evaluation = []
        for page in pages:
            for resource_tag_mapping in page['ResourceTagMappingList']:
                for rule in tag_rules:
                    if not (rule.get_rule_name() in exempted_resources_map):
                        exempted_resources_map[rule.get_rule_name()] = exception_list(rule.get_rule_name())
                    if rule.is_res_type_exempt(resource_tag_mapping["ResourceARN"]):
                        continue
                    if 'Tags' in resource_tag_mapping and len(resource_tag_mapping['Tags']) > 0:
                        evaluation = rule.get_evaluation(resource_tag_mapping)
                        all_evaluation.append(evaluation)
        return all_evaluation

def get_resources_evaluation_wo_tags(region: str):
    """Get resources that do not have the required tags."""
    resource_compliance = []
    rec = boto3.client('resource-explorer-2', region_name=region)
    tag_rules = [Tag004(), Tag001(), Tag002(), Tag005(), Tag008(), Tag009()]
    #tag_rules = [Tag004(), Tag008()]
    for rule in tag_rules:
        try:
            res = rec.search(
                QueryString=f'tag:none -service:cloudwatch -resourcetype:ec2:instance region:{region}')
            for resource in res['Resources']:
                if rule.is_res_type_exempt(resource["Arn"]):
                    continue
                resource_compliance.append({
                    "Name": rule.get_rule_name(),
                    "Location": region,
                    "Account ID": account_id,
                    "Account Name": "N/A", # TODO account name can be fetched
                    "Compliance": 'NON_COMPLIANT',
                    "Resource Type": rule.get_resource_type(resource['Arn']),
                    "Resource ID": resource['Arn'],
                    "Reason": "No tags or missing required tags",
                    "Evaluation Time": datetime.now().isoformat(),
                    "Bit ID": "",
                    "Environment": "",
                    "Additional Bit Ids": ""
                })
        except Exception as e:
            print(f"Error fetching resources without tags: {e}")

    return resource_compliance

def get_domain_exemptions(account_id: str):
    """
    Returns list of domains which are to be exempted for given account
    """
    domains_to_exempt = []
    connection_string = os.getenv("exemption_table_conn")
    table_name = "ResourceException"
    service = TableServiceClient.from_connection_string(conn_str=connection_string)
    table_client = service.get_table_client(table_name)
    query_filter_domains = " or ".join([f"RowKey eq '{key}'" for key in domain_rulename_map.keys()])
    query_filter = f"({query_filter_domains}) and AccountID eq '{account_id}'"
    records = list(table_client.query_entities(
        query_filter=query_filter
    ))
    for record in records:
        expiration_date = datetime.fromisoformat(str(record['ExpirationDate'])).date()
        if expiration_date >= datetime.now().date():
            domains_to_exempt.append(record["RowKey"])
    return domains_to_exempt

def exception_list(policy):
    connection_string = os.getenv("exemption_table_conn")
    table_name = "ResourceExemption"
    service = TableServiceClient.from_connection_string(conn_str=connection_string)
    table_client = service.get_table_client(table_name)
    query_filter = f"RowKey eq '{policy}'"
    entities = list(table_client.query_entities(
        query_filter=query_filter
    ))
    return entities


